{
  "manifest_version": 3,
  "name": "Heylighter",
  "version": "1.0",
  "description": "Highlight text on any webpage",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "menu.js",
        "highlight-anchor.js",
        "highlight-model.js",
        "highlight-dom.js",
        "storage.js",
        "content.js",
        "highlight-options.js",
        "highlight-hover.js"
      ],
      "css": ["menu.css"]
    }
  ]
}
