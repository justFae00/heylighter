{
  "manifest_version": 3,
  "name": "Heylighter",
  "version": "1.0",
  "description": "Highlight text on any webpage",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "docx.min.js",
        "colors.js",
        "highlight-settings.js",
        "menu.js",
        "highlight-anchor.js",
        "highlight-model.js",
        "highlight-dom.js",
        "highlight-options.js",
        "highlight-visibility.js",
        "storage.js",
        "highlight-hover.js",
        "clearing.js",
        "export.js",
        "content.js"
      ],
      "css": ["menu.css", "visibility.css"]
    }
  ]
}
